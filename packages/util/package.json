{
  "name": "@web3sheet/util",
  "description": "A collection of utility functions for Web3Sheet",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/web3sheet/web3sheet.git",
    "directory": "packages/util"
  },
  "author": {
    "email": "aerilym@pm.me",
    "name": "Aerilym",
    "url": "https://github.com/aerilym"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./string": {
      "import": "./dist/string.js",
      "require": "./dist/string.cjs"
    },
    "./maths": {
      "import": "./dist/maths.js",
      "require": "./dist/maths.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist/"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "check-types": "tsc --noEmit",
    "transpile": "tsup --config tsup.config.ts",
    "build": "rm -rf dist && pnpm transpile"
  },
  "devDependencies": {
    "@web3sheet/typescript-config": "workspace:*",
    "tsup": "^8.3.5"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9",
    "yarn": "use pnpm",
    "npm": "use pnpm"
  },
  "keywords": ["web3", "sheet", "eth", "wagmi", "ethereum", "dapps", "wallet"]
}
